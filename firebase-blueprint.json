{
  "entities": {
    "Client": {
      "title": "Client",
      "description": "B2B client brand configuration, competitors, and industry metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerId": { "type": "string" },
        "brandName": { "type": "string" },
        "aliases": { "type": "array" },
        "domain": { "type": "string" },
        "competitorDomains": { "type": "array" },
        "competitorBrands": { "type": "array" },
        "industry": { "type": "string" },
        "market": { "type": "string" },
        "language": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "ownerId", "brandName", "domain"]
    },
    "Prompt": {
      "title": "Prompt",
      "description": "Tracked verbatim query prompt for AI visibility testing",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerId": { "type": "string" },
        "clientId": { "type": "string" },
        "text": { "type": "string" },
        "intentLayer": { "type": "string" },
        "category": { "type": "string" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "ownerId", "clientId", "text"]
    },
    "RunCycle": {
      "title": "RunCycle",
      "description": "Run cycle metadata tracking N runs per prompt across engines",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerId": { "type": "string" },
        "clientId": { "type": "string" },
        "startedAt": { "type": "string" },
        "engines": { "type": "array" },
        "runsPerPrompt": { "type": "number" },
        "status": { "type": "string" },
        "callCount": { "type": "number" }
      },
      "required": ["id", "ownerId", "clientId", "startedAt"]
    },
    "Run": {
      "title": "Run",
      "description": "Single grounded run result capturing LLM answer, citations, and mentions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerId": { "type": "string" },
        "clientId": { "type": "string" },
        "cycleId": { "type": "string" },
        "promptId": { "type": "string" },
        "engine": { "type": "string" },
        "model": { "type": "string" },
        "runIndex": { "type": "number" },
        "runAt": { "type": "string" },
        "answerText": { "type": "string" },
        "brandMentioned": { "type": "boolean" },
        "brandCited": { "type": "boolean" }
      },
      "required": ["id", "ownerId", "clientId", "cycleId", "promptId"]
    },
    "Diagnostic": {
      "title": "Diagnostic",
      "description": "6-dimension diagnostic result for prompt and brand",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerId": { "type": "string" },
        "clientId": { "type": "string" },
        "promptId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "ownerId", "clientId", "promptId"]
    },
    "ActionItem": {
      "title": "ActionItem",
      "description": "Actionable recommendation to improve AEO / GEO visibility",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerId": { "type": "string" },
        "clientId": { "type": "string" },
        "title": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "ownerId", "clientId", "title"]
    },
    "PageAnalysis": {
      "title": "PageAnalysis",
      "description": "Analysis of client page content for AI extractability",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerId": { "type": "string" },
        "clientId": { "type": "string" },
        "url": { "type": "string" }
      },
      "required": ["id", "ownerId", "clientId", "url"]
    },
    "AppSettings": {
      "title": "AppSettings",
      "description": "Application configuration settings",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "defaultRunsPerPrompt": { "type": "number" },
        "activeEngine": { "type": "string" }
      },
      "required": ["id"]
    }
  },
  "firestore": {
    "/clients/{clientId}": {
      "schema": "Client",
      "description": "Collection of client organizations"
    },
    "/prompts/{promptId}": {
      "schema": "Prompt",
      "description": "Tracked search prompts per client"
    },
    "/runCycles/{cycleId}": {
      "schema": "RunCycle",
      "description": "Grounding measurement run cycles"
    },
    "/runs/{runId}": {
      "schema": "Run",
      "description": "Individual grounded model run outputs"
    },
    "/diagnostics/{diagnosticId}": {
      "schema": "Diagnostic",
      "description": "Prompt visibility diagnostics"
    },
    "/actions/{actionId}": {
      "schema": "ActionItem",
      "description": "Implementation action items"
    },
    "/pageAnalyses/{pageId}": {
      "schema": "PageAnalysis",
      "description": "Site page AI extractability audits"
    },
    "/settings/{settingsId}": {
      "schema": "AppSettings",
      "description": "Global user or organization settings"
    }
  }
}
