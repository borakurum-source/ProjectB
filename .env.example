# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PERPLEXITY_API_KEY: Optional API key for Perplexity Sonar grounding search engine.
PERPLEXITY_API_KEY=

# FIRECRAWL_API_KEY: Optional API key for Firecrawl Scrape, Map, and Search API.
FIRECRAWL_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: Neon Postgres connection string.
DATABASE_URL=

# SETUP_USER_EMAIL / SETUP_USER_PASSWORD: used once by `setup-user.ts` to seed
# the initial login user. Set these only when running that script.
SETUP_USER_EMAIL=
SETUP_USER_PASSWORD=

