rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isResourceOwner() {
      return isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }
    
    function isCreatingAsOwner() {
      return isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /clients/{docId} {
      allow read, update, delete: if isResourceOwner();
      allow create: if isCreatingAsOwner();
    }

    match /prompts/{docId} {
      allow read, update, delete: if isResourceOwner();
      allow create: if isCreatingAsOwner();
    }

    match /runCycles/{docId} {
      allow read, update, delete: if isResourceOwner();
      allow create: if isCreatingAsOwner();
    }

    match /runs/{docId} {
      allow read, update, delete: if isResourceOwner();
      allow create: if isCreatingAsOwner();
    }

    match /diagnostics/{docId} {
      allow read, update, delete: if isResourceOwner();
      allow create: if isCreatingAsOwner();
    }

    match /actions/{docId} {
      allow read, update, delete: if isResourceOwner();
      allow create: if isCreatingAsOwner();
    }

    match /pageAnalyses/{docId} {
      allow read, update, delete: if isResourceOwner();
      allow create: if isCreatingAsOwner();
    }
  }
}
